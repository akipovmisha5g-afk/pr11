print("\n=== Задача 3 ===")
MAX = 150

def find_solution():
    fifth = [i ** 5 for i in range(MAX + 1)]
    
    for a in range(1, MAX + 1):
        for b in range(a, MAX + 1):
            ab = fifth[a] + fifth[b]
            for c in range(b, MAX + 1):
                abc = ab + fifth[c]
                for d in range(c, MAX + 1):
                    total = abc + fifth[d]
                    for e in range(d + 1, MAX + 1):
                        if fifth[e] == total:
                            return a, b, c, d, e
    return None

result = find_solution()
if result:
    a, b, c, d, e = result
    print(f"Найдено решение: a={a}, b={b}, c={c}, d={d}, e={e}")
    print(f"Сумма a+b+c+d+e = {a + b + c + d + e}")
else:
    print("Решение не найдено")
